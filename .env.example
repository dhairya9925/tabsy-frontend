# ==============================================================================
# Frontend Environment Variables Template
# Copy this to .env (or .env.local) and customize for your environment.
# ==============================================================================

# ─── FastAPI Backend API ──────────────────────────────────────────────────────
# Local development: http://localhost:8000
# Production / VPS: e.g. https://api.yourdomain.com or http://<VPS_IP>:8000
VITE_API_URL="http://localhost:8000"

# ─── Supabase Authentication ──────────────────────────────────────────────────
# Required for user auth (login, signup, session tokens forwarded to FastAPI)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# ─── App Settings ─────────────────────────────────────────────────────────────
VITE_APP_URL="http://localhost:8080"
VITE_ENABLE_AUTH_VERIFICATION="false"
